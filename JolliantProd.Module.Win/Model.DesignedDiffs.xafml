<Application>
  <ActionDesign>
    <Actions>
      <Action Id="ImportGinilingAction" ValidationContexts="Save" />
      <Action Id="UpdateLotCountDB" TargetObjectsCriteria="IsCurrentUserInRole('Administrators')" />
